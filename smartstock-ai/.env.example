# Database Connection URL (PostgreSQL)
# For Host/Option A: postgresql://neondb_owner:npg_oKdcSfVG4g2J@localhost:5432/neondb
# For Docker/Option B: docker-compose automatically configures this to point to the "postgres" host
DATABASE_URL="postgresql://neondb_owner:npg_oKdcSfVG4g2J@localhost:5432/neondb"

# Secret key used for signing JWT login tokens
JWT_SECRET="your-super-secret-jwt-key-here"

# Google Gemini API key for the dashboard summary, recommendations, and ask-ai assistant
GEMINI_API_KEY="your-gemini-api-key-here"

# Model selection for Gemini API operations
# Fallback is gemini-3.6-flash if unspecified
GEMINI_MODEL="gemini-3.6-flash"
